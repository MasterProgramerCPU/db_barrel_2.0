#!/bin/bash
set -e

# Create system user for the service (no login shell, no home)
if ! getent passwd db-barrel > /dev/null 2>&1; then
    useradd --system --no-create-home --shell /usr/sbin/nologin db-barrel
fi

# Create data directory
mkdir -p /var/lib/db-barrel
chown db-barrel:db-barrel /var/lib/db-barrel

# Enable and start the service
systemctl daemon-reload
systemctl enable db-barrel.service

echo ""
echo "╔══════════════════════════════════════════════════════════╗"
echo "║  DB Barrel 2.0 installed successfully!                  ║"
echo "║                                                         ║"
echo "║  1. Configure the metadata database in:                 ║"
echo "║     sudo nano /etc/db-barrel/databases.json             ║"
echo "║                                                         ║"
echo "║     Expected catalog schema:                            ║"
echo "║     table: projects                                     ║"
echo "║     columns: name, barrel_configs                       ║"
echo "║                                                         ║"
echo "║  2. Insert one row per project; barrel_configs must     ║"
echo "║     contain the JSON database list for that project.    ║"
echo "║                                                         ║"
echo "║  3. Start the service:                                  ║"
echo "║     sudo systemctl start db-barrel                      ║"
echo "║                                                         ║"
echo "║  4. Open in browser:                                    ║"
echo "║     http://localhost:8080                                ║"
echo "╚══════════════════════════════════════════════════════════╝"
echo ""
